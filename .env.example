# Base URL of the app.
APP_URL=http://localhost:3000

# Development Postgres from docker-compose.yml. Port 5433 karena 5432 dipakai Postgres lokal.
DATABASE_URL=postgres://jadwalin:jadwalin@localhost:5433/jadwalin

# Minimal 32 karakter. Ganti dengan nilai acak di mesin sendiri.
SESSION_SECRET=development-only-session-secret-change-me

# 32 byte, base64, untuk enkripsi token OAuth. Wajib. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Dipakai `pnpm db:seed` saja, bukan oleh app.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ganti-password-ini
